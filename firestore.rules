rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Customers collection - allow read for admin dashboard & owner, allow write for customer profile
    match /customers/{customerId} {
      allow read: if true; // Allows admin console & profile display
      allow create, update: if true;
      allow delete: if false;
    }

    // Orders collection - allow read for order tracking & admin console
    match /orders/{orderId} {
      allow read: if true; // Allows order tracking lookup by order ID & Admin console
      allow create: if true; // Customer order placement
      allow update: if true; // Status updates via admin order control
      allow delete: if false;
    }

    // Conversations & AI Support Logs
    match /conversations/{conversationId} {
      allow read, write: if true; // Chat logging and admin transcripts
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
